<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.clientdemopublicqa</groupId>
  <artifactId>client-demo-public-qa-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>client-demo-public-qa (parent)</name>
  <description>Generated by qaff. Multi-module Java QA framework.</description>

  <modules>
    <module>framework-core</module>
    <module>framework-web-playwright</module>
    <module>framework-api</module>
    <module>framework-performance</module>
    <module>apps/demo-shop/web-desktop</module>
    <module>apps/demo-shop/api</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <junit.version>5.14.4</junit.version>
    <allure.version>2.35.3</allure.version>
    <aspectj.version>1.9.25</aspectj.version>
    <appiumJavaClient.version>10.1.1</appiumJavaClient.version>
    <rest-assured.version>5.5.7</rest-assured.version>
    <playwright.version>1.61.0</playwright.version>
  

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <!-- Dependency direction: the only internal (same groupId) artifacts a
         module may declare. framework-* modules inherit framework-core (for
         framework-core itself that means none); app modules override it with
         framework-*, which bans cross-app dependencies. -->
    <qaff.allowedInternalDependencies>framework-core</qaff.allowedInternalDependencies>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-bom</artifactId>
        <version>${allure.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured-bom</artifactId>
        <version>${rest-assured.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <!-- Allure HTML report: mvn allure:report / allure:serve, or
             scripts/allure-report.sh for one report across all modules. -->
        <plugin>
          <groupId>io.qameta.allure</groupId>
          <artifactId>allure-maven</artifactId>
          <version>2.18.0</version>
          <configuration>
            <reportVersion>2.46.1</reportVersion>
          </configuration>
        </plugin>
        <!-- Dependency direction (same rule as qaff verify): apps/* -> framework-*
             allowed; framework-* -> apps/*, framework-* -> any framework module
             other than framework-core, and app -> app are banned. Only direct
             declarations are checked (searchTransitive=false), like the qaff
             validator, so an app reaching framework-core via framework-web is fine. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce-dependency-direction</id>
              <phase>validate</phase>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <bannedDependencies>
                    <searchTransitive>false</searchTransitive>
                    <excludes>
                      <exclude>${project.groupId}:*</exclude>
                    </excludes>
                    <includes>
                      <include>${project.groupId}:${qaff.allowedInternalDependencies}</include>
                    </includes>
                    <message>Dependency direction violated in ${project.artifactId}: the only allowed internal dependencies are ${project.groupId}:${qaff.allowedInternalDependencies} (apps/* -> framework-*; framework-* -> framework-core; no app -> app).</message>
                  </bannedDependencies>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>web-external-smoke</id>
      <!--
        Web layer — manual-activation profile for external-target smoke.
        Activate with: mvn -B -P web-external-smoke verify
        Pass runtime base URL as -Dweb.baseUrl or QAFF_WEB_BASE_URL.
        Default mvn verify is not affected.
      -->
      <modules>
        <module>apps/demo-shop/web-desktop</module>
      </modules>
    </profile>
    <profile>
      <id>api-smoke</id>
      <!--
        Quality Impact Pack — manual-activation profile for API smoke only.
        Activate with: mvn -P api-smoke verify
        This profile is opt-in metadata only; use -pl apps/<id>/api -am for
        API-only Maven targeting. Default mvn verify is not affected.
      -->
      <modules>
        <module>apps/demo-shop/api</module>
      </modules>
    </profile>
  </profiles>
</project>
